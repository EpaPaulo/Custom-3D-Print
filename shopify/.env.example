# Copy to .env and fill in. Never commit the real values.

PORT=3000

# Where designs and orders are written.
DATA_DIR=./data

# Shopify admin -> Settings -> Notifications -> Webhooks shows this secret,
# or the app's API secret if the webhook was created by an app.
SHOPIFY_WEBHOOK_SECRET=

# Long random string guarding /admin. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Storefront origins allowed to create designs, comma separated.
ALLOWED_ORIGINS=https://your-shop.myshopify.com,https://www.yourdomain.com

# Only if the template lives somewhere other than ../assets/model/tm7-cover.stl
# TEMPLATE_STL=/srv/models/tm7-cover.stl
