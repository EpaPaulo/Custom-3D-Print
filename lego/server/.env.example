# Copy to .env and fill in. Never commit the real values.

PORT=3100

# Where designs and orders are written.
DATA_DIR=./data

# Shopify admin -> Settings -> Notifications -> Webhooks shows this secret,
# or the app's API secret if the webhook was created by an app.
SHOPIFY_WEBHOOK_SECRET=

# Long random string guarding /admin. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Storefront origins allowed to create designs, comma separated.
ALLOWED_ORIGINS=https://your-shop.myshopify.com,https://www.yourdomain.com

# Pricing, in your own currency. A quote is the base fee plus the material and
# the machine time, both of which come from actually slicing the plate — so
# these are rates, not guesses about any particular shape.
PRICE_BASE=4.50
PRICE_PER_GRAM=0.06
PRICE_PER_HOUR=1.20
CURRENCY=EUR

# Shipping. Quoted from the box the plate goes in: a printed plate is light and
# flat, so a carrier almost always bills it on volume rather than on weight, and
# the quote works that out per shape.
SHIPPING_ENABLED=1
SHIPPING_DEFAULT_ZONE=pt
# Waive the shipping charge once the plate itself reaches this much. 0 = never.
SHIPPING_FREE_ABOVE=0
# One price to send anything, instead of the zone table below.
# SHIPPING_FLAT=4.50

# THE BUILT-IN ZONE PRICES ARE PLACEHOLDERS. They have the shape a carrier's
# price list takes, filled in with plausible numbers so the generator quotes
# something out of the box. Put your carrier's own here before you sell
# anything — brackets by billed weight, then a per-kilo rate above the last one:
# SHIPPING_ZONES=[{"id":"pickup","label":"Levantamento","tiers":[]},{"id":"pt","label":"Portugal","tiers":[{"upToKg":0.5,"price":3.5},{"upToKg":2,"price":4.9}],"perExtraKg":1.5}]

# The parcel itself. VOLUMETRIC_DIVISOR is your carrier's — 5000 is the usual
# one, some use 4000, and a smaller number means size counts for more.
# PACKAGING_GRAMS=120
# PARCEL_PADDING_MM=25
# PARCEL_MIN_HEIGHT_MM=30
# VOLUMETRIC_DIVISOR=5000

# How this shop prints. The quote is only as good as this matches reality, so
# set it to the profile you really use. PRINT_PROFILE picks a preset — draft,
# normal or strong — and anything below overrides that preset's value.
PRINT_PROFILE=normal
# LAYER_HEIGHT=0.2
# WALLS=2
# TOP_LAYERS=4
# BOTTOM_LAYERS=3
# INFILL=0.15

# The machine and the filament. INFILL is a fraction, not a percentage.
# LINE_WIDTH=0.42
# FILAMENT_DIAMETER=1.75
# FILAMENT_DENSITY=1.24
# SPEED_FACTOR is the fraction of nominal speed actually achieved once
# acceleration is accounted for. Lower it if your prints run long.
# SPEED_FACTOR=0.72

# The plate STL is the product, so /api/plates/stl needs the admin token by
# default. Set this to 1 only if you are running the open generator, where the
# browser builds the same file for itself anyway.
ALLOW_PUBLIC_STL=0
